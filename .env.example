# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Project Settings → API).

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica

# ATENÇÃO: chave administrativa que ignora RLS.
# Uso exclusivo no servidor, apenas para o cadastro de novos membros da equipe.
# Nunca compartilhe, nunca versione e nunca exponha no navegador.
# Opcional: sem ela, o cadastro de membros fica indisponível.
SUPABASE_SERVICE_ROLE_KEY=
